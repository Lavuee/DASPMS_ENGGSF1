# Copy this file to .env and fill in the values. Never commit or share .env.

# ---------------------------------------------------------------
# Application
# ---------------------------------------------------------------
# local | production  (production forces secure cookies and hides error details)
APP_ENV=local
# Public base URL used in email links and payment redirects. Leave empty to
# derive it from the request. Must be a public HTTPS URL for PayMongo in production.
APP_BASE_URL=
# PHP and MySQL both use this zone
APP_TIMEZONE=Asia/Manila

# ---------------------------------------------------------------
# Database
# ---------------------------------------------------------------
DB_HOST=localhost
DB_NAME=daspms
DB_USER=root
DB_PASS=

# ---------------------------------------------------------------
# Sessions (seconds)
# ---------------------------------------------------------------
SESSION_IDLE_TIMEOUT=1800
SESSION_ABSOLUTE_TIMEOUT=28800
# true forces the Secure cookie flag (required when serving over HTTPS)
SESSION_SECURE_COOKIE=false

# ---------------------------------------------------------------
# Email
# ---------------------------------------------------------------
# log  = write emails to logs/mail.log (local testing, nothing is sent)
# smtp = send through SMTP using PHPMailer (recommended)
# mail = PHP mail() / XAMPP sendmail
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=daspms1998@gmail.com
MAIL_FROM_NAME="Norily's Repair Shop"
# SMTP settings (for Gmail use an App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=

# Token lifetimes
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60

# ---------------------------------------------------------------
# PayMongo (GCash online payments)
# Get keys from https://dashboard.paymongo.com/developers
# Leave PAYMONGO_SECRET_KEY empty to disable online GCash payments.
# ---------------------------------------------------------------
PAYMONGO_SECRET_KEY=
# Secret key of the webhook endpoint (whsk_...), shown when you create the webhook
PAYMONGO_WEBHOOK_SECRET=
# false = test mode (sk_test_ keys), true = live mode (sk_live_ keys)
PAYMONGO_LIVEMODE=false
PAYMONGO_API_BASE=https://api.paymongo.com/v1
# Smallest amount (PHP) accepted for an online payment
PAYMONGO_MIN_AMOUNT=20
# Optional path to a CA bundle if PHP's cURL cannot verify HTTPS certificates
PAYMONGO_CA_BUNDLE=
